{
  "name": "interview/product-import",
  "description": "Slim + Doctrine product XLSX import/export",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.4", "ext-bcmath": "*", "ext-curl": "*", "ext-dom": "*", "ext-fileinfo": "*", "ext-gd": "*", "ext-mbstring": "*", "ext-pdo": "*", "ext-zip": "*",
    "slim/slim": "^4.15", "slim/psr7": "^1.7", "doctrine/orm": "^3.3", "doctrine/migrations": "^3.9", "symfony/cache": "^7.3", "symfony/messenger": "^7.3", "symfony/amqp-messenger": "^7.3", "symfony/event-dispatcher": "^8.1", "symfony/dotenv": "^7.3", "phpoffice/phpspreadsheet": "^5.8.1"
  },
  "require-dev": {"phpunit/phpunit": "^11.5", "phpstan/phpstan": "^2.1", "friendsofphp/php-cs-fixer": "^3.75"},
  "autoload": {"psr-4": {"App\\": "src/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {"test": "phpunit", "analyse": "phpstan analyse --memory-limit=512M", "lint": "php-cs-fixer fix --dry-run --diff", "format": "php-cs-fixer fix"},
  "config": {"sort-packages": true, "allow-plugins": false}
}
