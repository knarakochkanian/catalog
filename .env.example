# Run make setup to create a private .env with random local passwords.
# Review .env and choose the administrator password before the first startup.
APP_ENV=production
# Exact public origin, no trailing slash. Change when reverse proxy/port changes.
APP_ORIGIN=http://localhost:8080
# Loopback port exposed by nginx.
HTTP_PORT=8080
# Use 1 when the public origin is HTTPS; keep 0 for local HTTP.
SESSION_SECURE=0
# Compose database identity; password generated by make setup.
POSTGRES_DB=product_import
POSTGRES_USER=product_import
POSTGRES_PASSWORD=
RABBITMQ_USER=product_import
RABBITMQ_PASSWORD=
# Migration creates this account; password must be at least 12 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Backend variables are derived by compose.yaml, not secrets committed here:
# DATABASE_URL=postgresql://<user>:<password>@db:5432/<database>
# MESSENGER_TRANSPORT_DSN=amqp://<user>:<password>@rabbitmq:5672/%2f/imports
# STORAGE_PATH=/app/backend/var/storage
